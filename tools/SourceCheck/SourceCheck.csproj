<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Not part of the solution: this is a developer check, not something the product ships.

    It exists because WinClipboard.App cannot be compiled anywhere but Windows — the Linux SDK
    has no Microsoft.NET.Sdk.WindowsDesktop — so the only compiler that ever sees its code is the
    one on CI. Errors that a compiler catches in a second were costing a push, a CI round and a
    red build to discover. This parses those sources with Roslyn instead, which needs no WPF
    references, and catches the mistakes that are visible without them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>
</Project>
