<Window x:Class="WinClipboard.App.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi tên"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#202020"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="#B3FFFFFF" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Style="{StaticResource SearchBoxStyle}" KeyDown="OnValueKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Huỷ" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClicked" />
            <Button Content="Đổi tên" Width="90" IsDefault="True" Click="OnConfirmClicked"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
