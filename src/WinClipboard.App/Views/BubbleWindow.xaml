<Window x:Class="WinClipboard.App.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinClipboard.Core.Models;assembly=WinClipboard.Core"
        Title="WinClipboard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="316" Height="320"
        AllowDrop="True"
        SourceInitialized="OnSourceInitialized"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        Deactivated="OnDeactivated">
    <!--
        Glass by translucency rather than by DWM's acrylic backdrop. The real thing would blur
        what is behind the window instead of merely tinting it, but it requires turning
        AllowsTransparency off — and without that WPF cannot render a transparent pixel, so the
        card would need an opaque background, which is precisely what the backdrop needs to show
        through. The two rule each other out. Given the appearance of the whole window rides on
        it and none of it can be tried outside Windows, this takes the version that behaves the
        same on Windows 10 and 11 over the one that looks better when it works.
    -->
    <Border x:Name="RootBackground" Background="{StaticResource GlassBrush}" CornerRadius="14"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="24" ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 mục"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="ShelfNameText" Text="Shelf" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!--
                Two views of the same shelf, one visible at a time — the card picks between them
                in ReloadAsync. A shelf of photos is unrecognisable as a column of filenames, and
                a shelf of documents is unrecognisable as a grid of identical page icons, so
                neither layout can serve both.

                The whole card takes drops; these are only where what landed is shown.
            -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                         MouseMove="OnItemMouseMove"
                         MouseLeftButtonUp="OnItemMouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- An image among documents still previews, just at row size. -->
                                <Border Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0" CornerRadius="4"
                                        ClipToBounds="True" Visibility="{Binding ThumbnailVisibility}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="15" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="ThumbnailGrid" Background="Transparent" BorderThickness="0"
                         Visibility="Collapsed"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                         MouseMove="OnItemMouseMove"
                         MouseLeftButtonUp="OnItemMouseUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="80" Margin="2,3" ToolTip="{Binding DisplayName}">
                                <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource ControlBrush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Glyph}" FontSize="26" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               Visibility="{Binding ThumbnailVisibility}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="10" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="Thả tệp vào đây" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" HorizontalAlignment="Center" />
                    <TextBlock Text="từ bất kỳ thư mục hay ứng dụng nào"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!--
                Always present, not only on an empty shelf. Dropping onto a tile runs that action
                on just what was dropped; clicking it runs it on everything the shelf holds.
            -->
            <UniformGrid x:Name="ActionBar" Grid.Row="2" Rows="1" Margin="0,10,0,0">
                <Button Content="Chuyển" Tag="{x:Static models:QuickActionType.MoveToFolder}"
                        ToolTip="Thả vào đây để chuyển, hoặc bấm để chuyển cả shelf"
                        Style="{StaticResource QuickActionButtonStyle}" AllowDrop="True"
                        DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                        DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                <Button Content="Sao chép" Tag="{x:Static models:QuickActionType.CopyToFolder}"
                        ToolTip="Thả vào đây để sao chép, hoặc bấm để sao chép cả shelf"
                        Style="{StaticResource QuickActionButtonStyle}" AllowDrop="True"
                        DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                        DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                <Button Content="Nén ZIP" Tag="{x:Static models:QuickActionType.Zip}"
                        ToolTip="Thả vào đây để nén, hoặc bấm để nén cả shelf"
                        Style="{StaticResource QuickActionButtonStyle}" AllowDrop="True"
                        DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                        DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                <Button Content="Mở panel" Tag="{x:Null}"
                        ToolTip="Mở panel đầy đủ: nhiều shelf, đổi tên, sắp xếp"
                        Style="{StaticResource QuickActionButtonStyle}" Click="OnOpenPanelClicked" />
            </UniformGrid>

            <!--
                Shown only once the shelf holds something, which is exactly when hiding it starts
                costing the user work: an empty shelf that disappears is no loss, one holding
                files that vanishes on a stray click is unusable if you cannot get it back.
            -->
            <TextBlock x:Name="RecallHint" Grid.Row="3" Visibility="Collapsed"
                       Text="Bấm ra ngoài để ẩn · Ctrl+Shift+D để gọi lại tại con trỏ"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                       TextAlignment="Center" Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>
