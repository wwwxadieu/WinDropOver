<Window x:Class="WinClipboard.App.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinClipboard.Core.Models;assembly=WinClipboard.Core"
        Title="WinClipboard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="340" Height="400"
        AllowDrop="True"
        SourceInitialized="OnSourceInitialized"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <!--
            The card's rounded outline, used to clip the glass layers. A Border's CornerRadius
            rounds what it paints but not what it contains, and ClipToBounds squares the corners
            off again, so the blur needs a geometry of its own. Literal because the window is a
            fixed size: 340x400 less the 12px margin the shadow needs to spill into.
        -->
        <RectangleGeometry x:Key="CardClip" Rect="0,0,316,376" RadiusX="14" RadiusY="14" />
    </Window.Resources>

    <!--
        Everything scales and fades together on open and close, so the margin here is doing two
        jobs: room for the drop shadow to fall into, and room for the opening overshoot to grow
        into without being cut off by the window edge.
    -->
    <Grid x:Name="CardRoot" Margin="12" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="CardSlide" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!--
            Bottom to top: the shadow caster, the glass, then the content. The caster is a plain
            filled rectangle whose own paint never shows — the glass covers it exactly — except
            when the backdrop capture fails, which is why its fill is the opaque fallback.
        -->
        <Border CornerRadius="14" Background="{StaticResource GlassBrush}">
            <Border.Effect>
                <!-- Sized to land inside the 12px margin: half the blur plus the depth. -->
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="3" />
            </Border.Effect>
        </Border>

        <Grid Clip="{StaticResource CardClip}">
            <!--
                A photograph of the desktop this card is about to cover, blurred. Drawn 40px
                oversized on every side (the capture is taken oversized to match) because a blur
                samples past its own edges: sized exactly, the four sides would fade out into
                nothing and the glass would look vignetted.
            -->
            <Image x:Name="BackdropImage" Stretch="Fill" Margin="-40" Visibility="Collapsed">
                <Image.Effect>
                    <BlurEffect Radius="36" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Rectangle x:Name="GlassTint" Fill="{StaticResource GlassBrush}" />
            <Rectangle Fill="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />
        </Grid>

        <Border x:Name="RootBackground" Background="Transparent" CornerRadius="14"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    No shelf name and no count here. The card only ever shows one shelf, so naming
                    it said nothing, and the count now lives on the pill below the stack where it
                    doubles as the control that opens the list.
                -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Button x:Name="CloseButton" HorizontalAlignment="Left"
                            Tag="{StaticResource IconClose}" ToolTip="Ẩn shelf (Ctrl+Shift+D để gọi lại)"
                            Style="{StaticResource CircleIconButtonStyle}" Click="OnCloseClicked" />
                    <!-- The grab bar. It marks the card as a thing that sits above your work rather than part of it. -->
                    <Border Width="34" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Background="{StaticResource ScrollThumbBrush}"
                            IsHitTestVisible="False" />
                    <Button x:Name="ClearButton" HorizontalAlignment="Right"
                            Tag="{StaticResource IconTrash}" ToolTip="Xoá hết nội dung trong shelf"
                            Style="{StaticResource CircleDangerButtonStyle}" Visibility="Collapsed"
                            Click="OnClearClicked" />
                </Grid>

                <!--
                    Two views of the same shelf, one visible at a time — the card picks between them
                    in ReloadAsync. A shelf of photos is unrecognisable as a column of filenames, and
                    a shelf of documents is unrecognisable as a grid of identical page icons, so
                    neither layout can serve both.

                    The whole card takes drops; these are only where what landed is shown.
                -->
                <Grid Grid.Row="1">
                    <!--
                        The default view: what the shelf holds, fanned out like a handful of paper.

                        A list of filenames is the wrong first answer for a shelf. The question it
                        exists to answer mid-drag is "did that land, and is this the pile I meant"
                        — which a glance at the actual documents settles and a column of truncated
                        names does not. Names, sizes and paths are still a click away on the pill.

                        Four slots, drawn back to front; the last one is always the upright card on
                        top. Their transforms are assigned in code because the fan has to reshape
                        itself for one, two, three or four items rather than leaving gaps.
                    -->
                    <Grid x:Name="StackView" Visibility="Collapsed" Background="Transparent"
                          ToolTip="Kéo cả chồng ra nơi cần"
                          PreviewMouseLeftButtonDown="OnStackPreviewMouseDown"
                          MouseMove="OnStackMouseMove"
                          MouseLeftButtonUp="OnItemMouseUp">
                        <Border x:Name="StackCard0" Style="{StaticResource StackCardStyle}">
                            <Grid>
                                <Image x:Name="StackIcon0" Style="{StaticResource StackIconStyle}" />
                                <Image x:Name="StackThumb0" Style="{StaticResource StackThumbStyle}" />
                            </Grid>
                        </Border>
                        <Border x:Name="StackCard1" Style="{StaticResource StackCardStyle}">
                            <Grid>
                                <Image x:Name="StackIcon1" Style="{StaticResource StackIconStyle}" />
                                <Image x:Name="StackThumb1" Style="{StaticResource StackThumbStyle}" />
                            </Grid>
                        </Border>
                        <Border x:Name="StackCard2" Style="{StaticResource StackCardStyle}">
                            <Grid>
                                <Image x:Name="StackIcon2" Style="{StaticResource StackIconStyle}" />
                                <Image x:Name="StackThumb2" Style="{StaticResource StackThumbStyle}" />
                            </Grid>
                        </Border>
                        <Border x:Name="StackCard3" Style="{StaticResource StackCardStyle}">
                            <Grid>
                                <Image x:Name="StackIcon3" Style="{StaticResource StackIconStyle}" />
                                <Image x:Name="StackThumb3" Style="{StaticResource StackThumbStyle}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ListBox x:Name="ItemsList" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                             MouseMove="OnItemMouseMove"
                             MouseLeftButtonUp="OnItemMouseUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3" ToolTip="{Binding ToolTipText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- An image among documents still previews, just at row size. -->
                                    <Border Grid.Column="0" Width="30" Height="30" Margin="0,0,8,0" CornerRadius="4"
                                            ClipToBounds="True" Visibility="{Binding ThumbnailVisibility}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <!--
                                        The file's own icon, straight from the shell — the same one it had in
                                        the folder it was dragged out of. Square footprint as the thumbnail
                                        above so rows line up whichever of the two a given item gets.
                                    -->
                                    <Image Grid.Column="0" Width="30" Height="30" Margin="0,0,8,0"
                                           Source="{Binding Icon}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IconVisibility}" />
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="17" Width="30"
                                               Margin="0,0,8,0" TextAlignment="Center"
                                               VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                                    <!--
                                        Name over kind-and-size. The name alone leaves the questions a
                                        collecting shelf actually raises unanswered — which of the two
                                        exports is this, is that the folder or the zip — and at this width
                                        it is usually truncated before the extension is even visible.
                                    -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="10" Margin="0,1,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DetailsVisibility}" />
                                    </StackPanel>
                                    <!--
                                        Taking one item off the shelf. The header's bin empties the
                                        whole thing, which is no use when a collection of nine is
                                        right except for one — and the detail list is where you are
                                        already looking when you notice.
                                    -->
                                    <Button Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center"
                                            Tag="{StaticResource IconClose}" ToolTip="Bỏ mục này khỏi shelf"
                                            Style="{StaticResource DangerIconButtonStyle}"
                                            Click="OnRemoveItemClicked" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="ThumbnailGrid" Background="Transparent" BorderThickness="0"
                             Visibility="Collapsed"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                             MouseMove="OnItemMouseMove"
                             MouseLeftButtonUp="OnItemMouseUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="80" Margin="2,3" ToolTip="{Binding ToolTipText}">
                                    <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True"
                                            Background="{StaticResource ControlBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding Glyph}" FontSize="26" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                                            <Image Width="40" Height="40" Source="{Binding Icon}" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconVisibility}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   Visibility="{Binding ThumbnailVisibility}" />
                                        </Grid>
                                    </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="10" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="Thả tệp vào đây" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" HorizontalAlignment="Center" />
                    <TextBlock Text="từ bất kỳ thư mục hay ứng dụng nào"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                </Grid>

                <!--
                    Says what the pile is — "3 tài liệu", "5 ảnh" — and opens the detail list, which
                    is where names, sizes and paths live. One control doing both because they are
                    the same question asked at two levels of detail.
                -->
                <Button x:Name="SummaryPill" Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Style="{StaticResource PillButtonStyle}" Visibility="Collapsed"
                        Click="OnToggleDetailsClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SummaryText" Text="0 mục" FontSize="11" VerticalAlignment="Center" />
                        <Path x:Name="SummaryChevron" Data="{StaticResource IconChevronRight}" Width="14" Height="14"
                              Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </StackPanel>
                </Button>

            <!--
                One button instead of a row of three.

                The row was permanently spread across the bottom of the card, spending a fifth of
                a 316px window on three targets that are only wanted at the end of a gesture. Now
                the actions stay folded away until a drag actually arrives over them, and then
                open as tiles big enough to aim at while holding a file — which is the only moment
                the size of the target matters.
            -->
            <Button x:Name="ActionToggle" Grid.Row="3" Margin="0,10,0,0"
                    Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center"
                    AllowDrop="True" ToolTip="Kéo file vào đây để chọn hành động"
                    DragEnter="OnActionToggleDragEnter" DragOver="OnActionDragOver"
                    Click="OnActionToggleClicked">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconBolt}" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Hành động" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!--
                The opened actions. Spans the whole middle of the card so that once it is showing,
                moving between tiles never takes the pointer outside it — the one thing that would
                otherwise fold it away mid-aim.
            -->
            <Border x:Name="ActionOverlay" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
                    Background="#E6101014" CornerRadius="12" Margin="0,0,0,2" AllowDrop="True"
                    DragOver="OnActionDragOver" DragLeave="OnActionOverlayDragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Thả vào một ô để chạy" Margin="0,12,0,4"
                               HorizontalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <!--
                        Two by two rather than four across. Four tiles in a 300px row leaves each
                        one 67px wide, which is a worse target than the flat row this replaced —
                        and the whole reason for opening them is to be easy to hit while holding a
                        file. Squared up they are more than twice as wide.
                    -->
                    <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="8,0,8,12">
                        <Button Content="Chuyển" Tag="{StaticResource IconMove}"
                                ToolTip="Thả vào đây để chuyển, hoặc bấm để chuyển cả shelf"
                                CommandParameter="{x:Static models:QuickActionType.MoveToFolder}"
                                Style="{StaticResource BigActionButtonStyle}" AllowDrop="True"
                                DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                                DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                        <Button Content="Sao chép" Tag="{StaticResource IconCopy}"
                                ToolTip="Thả vào đây để sao chép, hoặc bấm để sao chép cả shelf"
                                CommandParameter="{x:Static models:QuickActionType.CopyToFolder}"
                                Style="{StaticResource BigActionButtonStyle}" AllowDrop="True"
                                DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                                DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                        <Button Content="Nén ZIP" Tag="{StaticResource IconZip}"
                                ToolTip="Thả vào đây để nén, hoặc bấm để nén cả shelf"
                                CommandParameter="{x:Static models:QuickActionType.Zip}"
                                Style="{StaticResource BigActionButtonStyle}" AllowDrop="True"
                                DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                                DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                        <!--
                            The only tile that destroys anything, so it is the only red one. It
                            never acts on the drop itself: it asks first, and the two answers are
                            two different actions rather than one action with a checkbox.
                        -->
                        <Button Content="Xoá" Tag="{StaticResource IconTrash}"
                                ToolTip="Thả vào đây để xoá tệp — sẽ hỏi thùng rác hay xoá hẳn"
                                CommandParameter="{x:Static models:QuickActionType.DeleteToRecycleBin}"
                                Style="{StaticResource BigDangerButtonStyle}" AllowDrop="True"
                                DragEnter="OnActionDragEnter" DragOver="OnActionDragOver"
                                DragLeave="OnActionDragLeave" Drop="OnActionDrop" Click="OnActionClicked" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!--
                The delete question. Two buttons because there are genuinely two operations here,
                and a checkbox marked "permanently" next to one OK button is how people delete
                things they meant to keep. The recoverable one is first and plain; the one with no
                undo is red and says so on its own line.
            -->
            <Border x:Name="DeleteConfirm" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
                    Background="#F2101014" CornerRadius="12" Margin="0,0,0,2">
                <StackPanel VerticalAlignment="Center" Margin="18,0">
                    <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="DeleteConfirmText" Text="Xoá 0 tệp khỏi ổ đĩa?"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                               FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <Button Content="Đưa vào thùng rác" Margin="0,14,0,0"
                            Style="{StaticResource AccentButtonStyle}" Click="OnDeleteToRecycleBinClicked" />
                    <Button Content="Xoá vĩnh viễn" Margin="0,8,0,0"
                            Style="{StaticResource DangerTextButtonStyle}" Click="OnDeletePermanentlyClicked" />
                    <TextBlock Text="Không khôi phục lại được" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10" TextAlignment="Center" Margin="0,4,0,0" />
                    <Button Content="Huỷ" Margin="0,12,0,0" Style="{StaticResource PillButtonStyle}"
                            HorizontalAlignment="Center" Click="OnDeleteCancelClicked" />
                </StackPanel>
            </Border>

            <!--
                Shown only once the shelf holds something, which is exactly when hiding it starts
                costing the user work: an empty shelf that disappears is no loss, one holding
                files that vanishes on a stray click is unusable if you cannot get it back.
            -->
            <TextBlock x:Name="RecallHint" Grid.Row="4" Visibility="Collapsed"
                       Text="Bấm ra ngoài để ẩn · Ctrl+Shift+D để gọi lại tại con trỏ"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                       TextAlignment="Center" Margin="0,8,0,0" />
        </Grid>
        </Border>
    </Grid>
</Window>
