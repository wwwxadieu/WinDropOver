<Window x:Class="WinClipboard.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt WinClipboard"
        Width="480" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A1A"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Each settings group is a raised card, so the sections read as blocks instead of one
             long undifferentiated column of controls. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SubFieldStyle" TargetType="Grid">
            <!-- Indented to sit under the checkbox that enables it. -->
            <Setter Property="Margin" Value="27,8,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cài đặt" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- ==================== Kích hoạt Shelf ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Kích hoạt Shelf" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Ba cách mở shelf, bật/tắt độc lập nhau."
                                   Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,14" />

                        <CheckBox x:Name="RequireActiveDragCheck" Content="Chỉ mở khi đang thực sự kéo tệp" />
                        <TextBlock Text="Nhấn giữ chuột hoặc quét chọn nhiều mục sẽ không mở shelf. Tắt nếu máy bạn nhận diện sai."
                                   Style="{StaticResource FieldLabelStyle}" Margin="27,4,0,0" FontSize="11"
                                   TextWrapping="Wrap" />

                        <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,16,0,14" />

                        <!-- Kéo ra rìa -->
                        <CheckBox x:Name="EdgeTriggerCheck" Content="Kéo tệp ra rìa màn hình" />
                        <StackPanel Orientation="Horizontal" Margin="27,8,0,0">
                            <CheckBox x:Name="EdgeLeftCheck" Content="Trái" Margin="0,0,14,0" />
                            <CheckBox x:Name="EdgeRightCheck" Content="Phải" Margin="0,0,14,0" />
                            <CheckBox x:Name="EdgeTopCheck" Content="Trên" Margin="0,0,14,0" />
                            <CheckBox x:Name="EdgeBottomCheck" Content="Dưới" />
                        </StackPanel>
                        <Grid Style="{StaticResource SubFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Độ rộng vùng nóng (px)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" x:Name="EdgeMarginBox" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,16,0,14" />

                        <!-- Giữ phím -->
                        <CheckBox x:Name="HotkeyTriggerCheck" Content="Giữ phím trong lúc kéo" />
                        <Grid Style="{StaticResource SubFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Phím giữ" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1" x:Name="HoldKeyCombo" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,16,0,14" />

                        <!-- Lắc chuột -->
                        <CheckBox x:Name="ShakeTriggerCheck" Content="Lắc chuột trong lúc kéo" />
                        <TextBlock Text="Cách kích hoạt đặc trưng của Dropover."
                                   Style="{StaticResource FieldLabelStyle}" Margin="27,4,0,0" FontSize="11" />
                        <Grid Style="{StaticResource SubFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Độ nhạy — px mỗi nhịp, nhỏ hơn = nhạy hơn"
                                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="ShakeDistanceBox" />
                        </Grid>
                        <Grid Style="{StaticResource SubFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Số lần đổi chiều cần thiết"
                                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="ShakeChangesBox" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Bubble ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Bubble" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox x:Name="AutoHideCheck" Content="Tự ẩn khi rảnh và shelf trống" />
                        <Grid Style="{StaticResource SubFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sau (giây)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" x:Name="AutoHideSecondsBox" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Lịch sử clipboard ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Lịch sử clipboard" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Giới hạn số mục" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" x:Name="MaxHistoryBox" />
                        </Grid>

                        <CheckBox x:Name="PurgeEnabledCheck" Content="Tự xoá mục chưa ghim sau một thời gian"
                                  Margin="0,14,0,0" />
                        <Grid Style="{StaticResource SubFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Số giờ" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1" x:Name="PurgeHoursBox" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Hệ thống ==================== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Hệ thống" Style="{StaticResource SectionHeaderStyle}" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Khởi động cùng Windows" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Huỷ" Width="90" Margin="0,0,10,0" IsCancel="True" Click="OnCancelClicked" />
            <Button Content="Lưu" Width="90" IsDefault="True" Click="OnSaveClicked"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
