<Window x:Class="WinClipboard.App.Views.ShelfPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClipboard - Shelf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        MaxHeight="560"
        Deactivated="OnDeactivated">
    <Border Style="{StaticResource OverlayChromeStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Tag="{StaticResource IconPlus}" ToolTip="Thêm shelf mới"
                        Style="{StaticResource IconButtonStyle}" Click="OnAddShelfClicked" />
                <StackPanel x:Name="ShelfTabsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1">
                <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                         MouseMove="OnItemMouseMove"
                         MouseLeftButtonUp="OnItemMouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="Bấm đúp để đổi tên" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Tag="{StaticResource IconChevronUp}" ToolTip="Lên"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Click="OnMoveItemUpClicked" />
                                    <Button Tag="{StaticResource IconChevronDown}" ToolTip="Xuống"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Click="OnMoveItemDownClicked" />
                                    <Button Tag="{StaticResource IconPencil}" ToolTip="Đổi tên"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Click="OnRenameItemClicked" />
                                    <Button Tag="{StaticResource IconClose}" ToolTip="Xoá khỏi shelf"
                                            Style="{StaticResource DangerIconButtonStyle}" Width="26" Click="OnRemoveItemClicked" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyItemsText" Text="Kéo tệp vào bubble để bắt đầu" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16" Visibility="Collapsed" />
            </Grid>

            <!-- A separator makes it read as a distinct action bar rather than more list rows. -->
            <Border Grid.Row="2" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,0" Padding="0,10,0,0">
                <UniformGrid Rows="1">
                    <Button x:Name="MoveButton" Content="Chuyển" ToolTip="Chuyển tất cả vào thư mục"
                            Style="{StaticResource QuickActionButtonStyle}" Click="OnMoveClicked" />
                    <Button x:Name="CopyFolderButton" Content="Sao chép" ToolTip="Sao chép tất cả vào thư mục"
                            Style="{StaticResource QuickActionButtonStyle}" Click="OnCopyToFolderClicked" />
                    <Button x:Name="ZipButton" Content="Nén ZIP" ToolTip="Nén tất cả thành tệp ZIP"
                            Style="{StaticResource QuickActionButtonStyle}" Click="OnZipClicked" />
                    <Button x:Name="ClipboardButton" Content="Copy" ToolTip="Sao chép vào Clipboard"
                            Style="{StaticResource QuickActionButtonStyle}" Click="OnCopyToClipboardClicked" />
                </UniformGrid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
