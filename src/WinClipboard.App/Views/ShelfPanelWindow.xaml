<Window x:Class="WinClipboard.App.Views.ShelfPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WinClipboard.Core.Models;assembly=WinClipboard.Core"
        Title="WinClipboard - Shelf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        MaxHeight="560"
        Deactivated="OnDeactivated">
    <Border Style="{StaticResource OverlayChromeStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Tag="{StaticResource IconPlus}" ToolTip="Thêm shelf mới"
                        Style="{StaticResource IconButtonStyle}" Click="OnAddShelfClicked" />
                <StackPanel x:Name="ShelfTabsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1">
                <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                         MouseMove="OnItemMouseMove"
                         MouseLeftButtonUp="OnItemMouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Same three-way fallback as the shelf card: preview, then the file's own icon, then a glyph. -->
                                <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0" Source="{Binding Thumbnail}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding ThumbnailVisibility}" />
                                <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0" Source="{Binding Icon}"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding IconVisibility}" />
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="16" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="Bấm đúp để đổi tên" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Tag="{StaticResource IconChevronUp}" ToolTip="Lên"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Click="OnMoveItemUpClicked" />
                                    <Button Tag="{StaticResource IconChevronDown}" ToolTip="Xuống"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Click="OnMoveItemDownClicked" />
                                    <Button Tag="{StaticResource IconPencil}" ToolTip="Đổi tên"
                                            Style="{StaticResource IconButtonStyle}" Width="26" Click="OnRenameItemClicked" />
                                    <Button Tag="{StaticResource IconClose}" ToolTip="Xoá khỏi shelf"
                                            Style="{StaticResource DangerIconButtonStyle}" Width="26" Click="OnRemoveItemClicked" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyItemsText" Text="Kéo tệp vào bubble để bắt đầu" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16" Visibility="Collapsed" />
            </Grid>

            <!--
                Each action is a drop target as well as a button, which is how Dropover works:
                drag items onto an action to run it on just those, or click it to run it on the
                whole shelf. Tag carries the action so one pair of handlers serves all four.
            -->
            <Border Grid.Row="2" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Kéo mục thả vào một hành động, hoặc bấm để áp dụng cho cả shelf"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="2,0,2,8" />
                    <UniformGrid Rows="1">
                        <Button x:Name="MoveButton" Content="Chuyển" Tag="{x:Static models:QuickActionType.MoveToFolder}"
                                ToolTip="Thả mục vào đây để chuyển, hoặc bấm để chuyển cả shelf"
                                Style="{StaticResource QuickActionButtonStyle}"
                                AllowDrop="True" DragEnter="OnQuickActionDragEnter" DragOver="OnQuickActionDragOver"
                                DragLeave="OnQuickActionDragLeave" Drop="OnQuickActionDrop" Click="OnMoveClicked" />
                        <Button x:Name="CopyFolderButton" Content="Sao chép" Tag="{x:Static models:QuickActionType.CopyToFolder}"
                                ToolTip="Thả mục vào đây để sao chép, hoặc bấm để sao chép cả shelf"
                                Style="{StaticResource QuickActionButtonStyle}"
                                AllowDrop="True" DragEnter="OnQuickActionDragEnter" DragOver="OnQuickActionDragOver"
                                DragLeave="OnQuickActionDragLeave" Drop="OnQuickActionDrop" Click="OnCopyToFolderClicked" />
                        <Button x:Name="ZipButton" Content="Nén ZIP" Tag="{x:Static models:QuickActionType.Zip}"
                                ToolTip="Thả mục vào đây để nén, hoặc bấm để nén cả shelf"
                                Style="{StaticResource QuickActionButtonStyle}"
                                AllowDrop="True" DragEnter="OnQuickActionDragEnter" DragOver="OnQuickActionDragOver"
                                DragLeave="OnQuickActionDragLeave" Drop="OnQuickActionDrop" Click="OnZipClicked" />
                        <Button x:Name="ClipboardButton" Content="Copy" Tag="{x:Static models:QuickActionType.CopyToClipboard}"
                                ToolTip="Thả mục vào đây để copy, hoặc bấm để copy cả shelf"
                                Style="{StaticResource QuickActionButtonStyle}"
                                AllowDrop="True" DragEnter="OnQuickActionDragEnter" DragOver="OnQuickActionDragOver"
                                DragLeave="OnQuickActionDragLeave" Drop="OnQuickActionDrop" Click="OnCopyToClipboardClicked" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
