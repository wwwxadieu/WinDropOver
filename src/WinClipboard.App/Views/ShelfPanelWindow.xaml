<Window x:Class="WinClipboard.App.Views.ShelfPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClipboard - Shelf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        MaxHeight="560"
        Deactivated="OnDeactivated">
    <Border Style="{StaticResource OverlayChromeStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="&#43;" ToolTip="Thêm shelf mới"
                        Style="{StaticResource IconButtonStyle}" Click="OnAddShelfClicked" />
                <StackPanel x:Name="ShelfTabsPanel" Orientation="Horizontal" />
            </DockPanel>

            <Grid Grid.Row="1">
                <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonDown="OnItemPreviewMouseDown"
                         MouseMove="OnItemMouseMove"
                         MouseLeftButtonUp="OnItemMouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="&#10005;" Style="{StaticResource IconButtonStyle}" Click="OnRemoveItemClicked" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyItemsText" Text="Kéo tệp vào bubble để bắt đầu" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16" Visibility="Collapsed" />
            </Grid>

            <UniformGrid Grid.Row="2" Rows="1" Margin="0,10,0,0">
                <Button x:Name="MoveButton" Content="Chuyển" ToolTip="Chuyển tất cả vào thư mục"
                        Style="{StaticResource IconButtonStyle}" Click="OnMoveClicked" Margin="0,0,2,0" />
                <Button x:Name="CopyFolderButton" Content="Sao chép" ToolTip="Sao chép tất cả vào thư mục"
                        Style="{StaticResource IconButtonStyle}" Click="OnCopyToFolderClicked" Margin="2,0" />
                <Button x:Name="ZipButton" Content="Nén ZIP" ToolTip="Nén tất cả thành tệp ZIP"
                        Style="{StaticResource IconButtonStyle}" Click="OnZipClicked" Margin="2,0" />
                <Button x:Name="ClipboardButton" Content="Copy" ToolTip="Sao chép vào Clipboard"
                        Style="{StaticResource IconButtonStyle}" Click="OnCopyToClipboardClicked" Margin="2,0,0,0" />
            </UniformGrid>

            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
