<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The application mark as vector, so it stays crisp at any size and on any DPI instead of
        being scaled from a bitmap.

        The same geometry is defined in tools/make-icon.py, which renders assets/WinClipboard.ico
        for the places Windows insists on a real icon file — the taskbar, the tray, the Start
        menu, Apps & features. Change one and change the other; they are the same mark.

        Coordinates are the unit square scaled by 100, matching that script.
    -->
    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#3B82F6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,6,88,88" RadiusX="22" RadiusY="22" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrow shaft. -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="43.5,18.5,13,28" RadiusX="5.5" RadiusY="5.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Arrow head. -->
                <GeometryDrawing Brush="White" Geometry="M 31.5,42 L 68.5,42 L 50,65.5 Z" />
                <!-- The tray it drops into. -->
                <GeometryDrawing Brush="#CDFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="20.5,71.5,59,13.5" RadiusX="6" RadiusY="6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
