<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Palette ============================ -->
    <!--
        Fluent-ish dark palette (plan section 4). A translucent surface stands in for true DWM
        acrylic/mica, which would need a DwmSetWindowAttribute call this project has not added;
        the look degrades to a plain semi-transparent panel either way.
    -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F51E1E1E" />
    <!--
        The shelf card's surface. Translucent enough that what is underneath reads through it, so
        the card sits *over* the desktop rather than on top of it, but far enough from clear that
        filenames stay legible against a busy background. The border is brighter than the app's
        usual one because a glass edge is the only thing separating the card from whatever it
        happens to be floating above.
    -->
    <SolidColorBrush x:Key="GlassBrush" Color="#D91C1C20" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#40FFFFFF" />

    <!--
        The two layers that sit on top of the blurred snapshot of the desktop, in that order.

        GlassTintBrush is much thinner than GlassBrush above: with a real blur underneath there is
        no longer anything to hide, and the tint only has to darken the pane enough for white text
        to hold up over a bright wallpaper. GlassBrush stays as the fallback for when the capture
        fails, where it is doing the whole job on its own and has to be near-opaque.

        GlassSheenBrush is the highlight that reads as a physical pane rather than a tinted hole:
        brighter along the top edge, where a sheet of glass catches the light.
    -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#8C16161C" />
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2EFFFFFF" />
        <GradientStop Offset="0.35" Color="#0AFFFFFF" />
        <GradientStop Offset="0.75" Color="#00FFFFFF" />
        <GradientStop Offset="1" Color="#12FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B9BFB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C6FD8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#333B82F6" />
    <SolidColorBrush x:Key="ControlBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

    <!-- ============================ Icons ============================ -->
    <!--
        Vector paths rather than emoji glyphs: emoji render at whatever size and weight the
        installed font decides, and cannot take a hover colour.

        Drawn to the convention the well-known stroke icon sets use — a 24x24 grid, 2-unit
        stroke, round caps and joins, shapes spanning ~12 units — and rendered through a fixed
        24x24 Canvas inside a Viewbox (see the button templates) so one scale factor applies to
        all of them. Following a single convention is most of what makes a set look deliberate
        rather than assembled.

        Two rules learned the hard way here:
        * Spans must match across icons. The X was 14 units against 9-unit chevrons, so it
          shouted while they looked timid at identical button sizes.
        * An outlined shape needs an interior wider than twice the stroke, or the outline closes
          over itself. The pencil's body was 3 units against a 2.1 stroke and rendered as a lumpy
          blob rather than a pencil.
    -->
    <PathGeometry x:Key="IconClose" Figures="M 18,6 L 6,18 M 6,6 L 18,18" />
    <PathGeometry x:Key="IconChevronUp" Figures="M 18,15 L 12,9 L 6,15" />
    <PathGeometry x:Key="IconChevronDown" Figures="M 6,9 L 12,15 L 18,9" />
    <PathGeometry x:Key="IconChevronRight" Figures="M 9,6 L 15,12 L 9,18" />

    <!-- The three quick actions, as the shapes they are: a thing going somewhere, a thing
         duplicated, a thing boxed up. -->
    <PathGeometry x:Key="IconMove" Figures="M 3,12 L 13,12 M 9.5,8.5 L 13,12 L 9.5,15.5 M 17,4 L 21,4 L 21,20 L 17,20" />
    <PathGeometry x:Key="IconCopy" Figures="M 9,9 L 20,9 L 20,20 L 9,20 Z M 5,15 L 4,15 L 4,4 L 15,4 L 15,5" />
    <PathGeometry x:Key="IconZip" Figures="M 3,9 L 21,9 L 21,20 L 3,20 Z M 3,9 L 5.5,4 L 18.5,4 L 21,9 M 12,9 L 12,20" />
    <PathGeometry x:Key="IconBolt" Figures="M 13,3 L 6,13 L 11.5,13 L 11,21 L 18,11 L 12.5,11 Z" />
    <PathGeometry x:Key="IconPlus" Figures="M 6,12 L 18,12 M 12,6 L 12,18" />
    <!-- Alone inside the checkbox, so it is not competing with a neighbour for size. -->
    <PathGeometry x:Key="IconCheck" Figures="M 19,7 L 9.5,16.5 L 5,12" />
    <!-- Eraser edge, two body sides, sharpened tip, then the ferrule line across.
         The body is 5.4 units wide so the outline does not close over itself. -->
    <PathGeometry x:Key="IconPencil" Figures="M 14.2,6 L 18,9.8 L 11,16.8 L 6.3,17.7 L 7.2,13 Z M 12.8,7.4 L 16.6,11.2" />
    <!-- Push pin: cap, body, flared base, needle. Outlined at rest, filled once pinned. -->
    <PathGeometry x:Key="IconPin" Figures="M 9,5 L 15,5 L 15,11 L 17.5,15 L 6.5,15 L 9,11 Z M 12,15 L 12,19" />
    <!-- Bin: lid, handle above it, tapering body, two ribs. Same 24x24 grid and ~12-unit span
         as the rest, so it does not loom next to them. -->
    <PathGeometry x:Key="IconTrash" Figures="M 5,7 L 19,7 M 10,7 L 10,5 L 14,5 L 14,7 M 6.5,7 L 7.5,19 L 16.5,19 L 17.5,7 M 10.5,10.5 L 10.5,15.5 M 13.5,10.5 L 13.5,15.5" />

    <!-- ============================ Surfaces ============================ -->

    <Style x:Key="OverlayChromeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="28" ShadowDepth="6" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================ Scroll bars ============================ -->
    <!--
        The default Windows scroll bar (grey track, stepper arrows, ~17px wide) sat inside these
        dark rounded panels looking like a piece of a different application. This one is an 8px
        overlay strip with just a rounded thumb.
    -->
    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{StaticResource ScrollThumbBrush}"
                            CornerRadius="4" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- A horizontal track runs the other way, and the page commands differ. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Buttons ============================ -->

    <!--
        Icon buttons take their glyph from Tag so call sites stay a single line:
            <Button Style="{StaticResource IconButtonStyle}" Tag="{StaticResource IconClose}" .../>
        Stroke rather than Fill, so the same geometry works for both line icons (close, chevrons)
        and closed shapes.
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                        <!-- Fixed 24x24 Canvas inside the Viewbox: every icon is scaled by the
                             same factor, so they keep their designed relative sizes. -->
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The shelf card's own header buttons: filled circles rather than the flat square hit areas
        used elsewhere. They float over a translucent pane with no toolbar behind them, so the
        filled disc is what makes them read as buttons at all — without it they are two glyphs
        sitting on top of a photograph.
    -->
    <Style x:Key="CircleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource ControlBrush}" CornerRadius="14">
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same circle, red on hover, for the one destructive control in the card header. -->
    <Style x:Key="CircleDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CircleIconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{StaticResource ControlBrush}" CornerRadius="14">
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A quick action as a large drop target: icon above label, filling its share of the row.
        These only exist while a drag is hovering the action button, and the whole point of
        opening them is that they are big enough to aim at mid-drag — the flat little row they
        replaced asked the user to hit a 60x28 rectangle while holding a file.
    -->
    <Style x:Key="BigActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Opacity rather than a Background setter, so the accent fill the drop
                             handler assigns is not overwritten the moment the pointer arrives. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One sheet in the fanned stack on the shelf card.

        Paper-coloured rather than themed: these stand for the documents themselves, and a
        document is a white rectangle regardless of what the surrounding window looks like. That
        is also what makes the fan legible against the card's own dark glass — a stack of dark
        cards on a dark pane is a smudge.

        RenderTransformOrigin at the centre so the rotation assigned in code turns each sheet
        about its own middle rather than swinging it from the corner.
    -->
    <Style x:Key="StackCardStyle" TargetType="Border">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="108" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="#FFF7F7F9" />
        <Setter Property="BorderBrush" Value="#33000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="12" ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A document sheet shows the file's own icon, centred, the way a folder view would. -->
    <Style x:Key="StackIconStyle" TargetType="Image">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- An image fills its sheet edge to edge instead: the picture is the preview. -->
    <Style x:Key="StackThumbStyle" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!--
        The capsule under the stack that names what the shelf is holding and opens the detail list.
        Its own style rather than a themed Button because it is the one control on the card that is
        meant to look like a label you can press, not a button you must.
    -->
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="13"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape, but hover turns the icon red: used for destructive actions. -->
    <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                        <!-- Fixed 24x24 Canvas inside the Viewbox: every icon is scaled by the
                             same factor, so they keep their designed relative sizes. -->
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1FEF4444" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <!-- Stroked like every other icon, and additionally filled once
                                     checked: outline vs solid says "pinned" at a glance, which
                                     colour alone does not. -->
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default look for any plain Button: a quiet filled pill that matches the dark surfaces. -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick Actions: wide, evenly-sized targets that read as buttons rather than bare labels. -->
    <!--
        Quick Action tiles are drop targets, and the code-behind highlights the one under the
        cursor by setting Background locally. The shared Button template would lose that: its
        IsMouseOver trigger sets the Border's Background by TargetName, which outranks the
        TemplateBinding. So these tiles get hover/press feedback through Opacity instead, leaving
        Background free for the drop highlight to win.
    -->
    <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shelf tab strip. Colour comes from the shelf itself, so it is set per-button in code. -->
    <Style x:Key="ShelfTabStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterChipStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Inputs ============================ -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless variant for the history search field. -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource ControlBrush}"
                                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Viewbox x:Name="Check" Width="13" Height="13" Visibility="Collapsed"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconCheck}"
                                          Stroke="White" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ComboBox needs a full template, not just brushes: its default template paints its own
        light chrome and ignores Background, so setting only Foreground gives light text on a
        light box.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1" CornerRadius="6" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,28,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <Viewbox Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Margin="0,0,9,0" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconChevronDown}"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               VerticalOffset="4">
                            <Border Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="16" ShadowDepth="3" />
                                </Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The popup is its own visual tree, so items need their colours set explicitly. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Lists ============================ -->

    <!--
        Implicit (no x:Key) so every ListBoxItem picks it up: a flat row that only tints on
        hover/selection, instead of the default blue box which would look wrong against these
        translucent surfaces.
    -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
