<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned TFM (rather than plain net8.0-windows) so the SDK generates CsWinRT
         projections for Windows.ApplicationModel.DataTransfer, used by the Share quick action. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Lets `dotnet restore`/`build` evaluate this Windows-targeted project from non-Windows
         hosts (this repo was assembled in a Linux sandbox); irrelevant on a real Windows build. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Gives the .exe its icon in Explorer, the taskbar and Alt+Tab. -->
    <ApplicationIcon>..\..\assets\WinClipboard.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinClipboard</AssemblyName>
    <RootNamespace>WinClipboard.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinClipboard.Core\WinClipboard.Core.csproj" />
    <ProjectReference Include="..\WinClipboard.Data\WinClipboard.Data.csproj" />
    <ProjectReference Include="..\WinClipboard.Interop\WinClipboard.Interop.csproj" />
  </ItemGroup>

  <!--
    UseWindowsForms adds implicit global usings for System.Windows.Forms and System.Drawing
    project-wide (needed only by Services/TrayIconService.cs, for NotifyIcon). Those collide
    with same-named WPF types (Button, Point, DragEventArgs, MouseEventArgs, ...) everywhere
    else in the project. TrayIconService.cs has its own explicit `using` for both namespaces,
    so removing the implicit ones here only affects unqualified lookups elsewhere.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as well as compiled into the exe header: the tray needs an Icon object at
         runtime, and extracting it from the executable is more fragile than just carrying it. -->
    <Resource Include="..\..\assets\WinClipboard.ico" Link="Assets\WinClipboard.ico" />
  </ItemGroup>

</Project>
